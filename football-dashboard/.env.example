# Copia este archivo como .env y rellena tus propias claves.
# No subas el archivo .env al repositorio.

# Groq — modelo openai/gpt-oss-120b
# https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Odds API — fallback cuando Sofascore no está disponible
# https://the-odds-api.com (500 req/mes gratis)
VITE_ODDS_API_KEY=tu_clave_de_the_odds_api

# API-Football — H2H, clasificación y ventaja de local
# https://dashboard.api-football.com/
VITE_APIFOOTBALL_API_KEY=tu_clave_de_api_football
